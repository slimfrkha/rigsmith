# py python3 · uvr uv run · uvs uv sync · uva uv add · uvad uv add --dev · uvp uv pip
# venv   create .venv and activate it · activate   activate .venv
alias py='python3'
alias uvr='uv run'
alias uvs='uv sync'
alias uva='uv add'
alias uvad='uv add --dev'
alias uvp='uv pip'
alias venv='uv venv && source .venv/bin/activate'
alias activate='source .venv/bin/activate'
