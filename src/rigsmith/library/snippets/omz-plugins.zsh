# oh-my-zsh plugins without oh-my-zsh.
#   ESC ESC        prefix the current/previous command with sudo
#   copypath       copy the current directory path
#   copyfile FILE  copy a file's contents
zinit snippet OMZP::sudo
zinit snippet OMZP::colored-man-pages
zinit snippet OMZP::copypath
zinit snippet OMZP::copyfile
