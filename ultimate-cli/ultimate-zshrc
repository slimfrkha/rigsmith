    alias grep='rg'
    alias rgi='rg -i'       # Case insensitive
    alias rgl='rg -l'       # Files only
    alias rgc='rg -c'       # Count matches
    alias rgh='rg --hidden' # Include hidden files
fi

# ─── fd (find replacement) ────────────────────────────────────────────────
