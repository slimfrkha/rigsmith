# ─── eza (ls replacement) ─────────────────────────────────────────────────
if command -v eza &> /dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -l -g --icons --group-directories-first --git'
    alias la='eza -la --icons --group-directories-first --git'
    alias lt='eza --tree --icons -a -I ".git|__pycache__|.mypy_cache|.ipynb_checkpoints|node_modules|.venv"'
    alias lt2='eza --tree --level=2 --icons --group-directories-first'
    alias lt3='eza --tree --level=3 --icons --group-directories-first'
    alias lta='eza --tree --level=2 --icons --group-directories-first -a'
    alias lsize='eza -la --icons --sort=size --reverse'
    alias ltime='eza -la --icons --sort=modified'
    alias lext='eza -la --icons --sort=extension'
fi

# ─── bat (cat replacement) ────────────────────────────────────────────────
if command -v bat &> /dev/null; then
    alias cat='bat --paging=never'
    alias catp='bat --plain'                    # No line numbers/decorations
    alias catl='bat --line-range'               # Show specific lines

    # Use bat for man pages (beautiful!)
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
fi

# ─── ripgrep (grep replacement) ───────────────────────────────────────────
