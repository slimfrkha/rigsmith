# Create directory and cd into it
mkcd() {
    mkdir -p "$@" && cd "$_"
}

# Extract any archive
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar e "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *.xz)        unxz "$1"        ;;
            *.lzma)      unlzma "$1"      ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Find and kill process with fzf
fkill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf -m --header='Select process to kill' | awk '{print $2}')
    if [ "x$pid" != "x" ]; then
        echo $pid | xargs kill -${1:-9}
        echo "Process(es) killed!"
    fi
}

# Quick note taking
note() {
    local notes_dir="$HOME/notes"
    mkdir -p "$notes_dir"
    if [ $# -eq 0 ]; then
        $EDITOR "$notes_dir"
    else
        echo "$(date '+%Y-%m-%d %H:%M'): $*" >> "$notes_dir/quick-notes.md"
        echo "📝 Note added!"
    fi
}

# Search in files with preview
rgs() {
    rg --color=always --line-number --no-heading --smart-case "$@" |
    fzf --ansi \
        --color "hl:-1:underline,hl+:-1:underline:reverse" \
        --delimiter : \
        --preview 'bat --color=always {1} --highlight-line {2}' \
        --preview-window 'up,60%,border-bottom,+{2}+3/3,~3' \
        --bind 'enter:become(micro {1} +{2})'
}

# Fuzzy git checkout branch
gfco() {
    local branches branch
    branches=$(git branch --all | grep -v HEAD) &&
    branch=$(echo "$branches" |
             fzf --preview "git log --oneline --graph --date=short --color=always --pretty='%C(auto)%h%d %s %C(black)%C(bold)%cr' \$(echo {} | sed 's/.* //' | sed 's#remotes/[^/]*/##')" |
             sed "s/.* //" | sed "s#remotes/[^/]*/##") &&
    git checkout "$branch"
}

# Interactive git log
gitlog() {
    git log --graph --color=always --format="%C(auto)%h%d %s %C(black)%C(bold)%cr" "$@" |
    fzf --ansi --no-sort --reverse --tiebreak=index --preview \
        'f() { set -- $(echo "$@" | grep -o "[a-f0-9]\{7,\}"); [ $# -eq 0 ] || git show --color=always $1; }; f {}' \
        --header "enter: view, ctrl-y: copy hash" \
        --bind "enter:execute:git show --color=always \$(echo {} | grep -o '[a-f0-9]\{7,\}' | head -1) | less -R" \
        --bind "ctrl-y:execute-silent(echo {} | grep -o '[a-f0-9]\{7,\}' | head -1 | pbcopy)+abort"
}

# Quick backup of a file
bak() {
    cp "$1" "$1.bak.$(date +%Y%m%d_%H%M%S)"
    echo "📦 Backed up to $1.bak.$(date +%Y%m%d_%H%M%S)"
}

# Create a new project directory with common structure
newproject() {
    if [ -z "$1" ]; then
        echo "Usage: newproject <project-name>"
        return 1
    fi
    mkdir -p "$HOME/projects/$1"/{src,tests,docs}
    cd "$HOME/projects/$1"
    git init
    echo "# $1" > README.md
    echo "🚀 Project $1 created!"
}

# Show directory size sorted
dirsize() {
    du -sh ${1:-.}/* 2>/dev/null | sort -hr | head -20
}

# Weather for specific location
wttr() {
    curl "wttr.in/${1:-}"
}

# Cheatsheet for common commands (uses tldr)
cheat() {
    tldr "$1" || curl "cheat.sh/$1"
}

# Port usage checker
port() {
    lsof -i ":$1"
}

