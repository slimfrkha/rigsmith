{
  // ═══════════════════════════════════════════════════════════════════════════
  // VS CODE SETTINGS (Minimalist Edition)
  // ═══════════════════════════════════════════════════════════════════════════
  //
  // Cmd+Shift+P → "Preferences: Open User Settings (JSON)"
  //
  // ═══════════════════════════════════════════════════════════════════════════
  // ═══════════════════════════════════════════════════════════════════════════
  // 🎨 APPEARANCE
  // ═══════════════════════════════════════════════════════════════════════════
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.startupEditor": "none",
  // Font
  "editor.fontFamily": "JetBrains Mono, MesloLGS NF, Menlo, Monaco, monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  // Cursor
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  // Scrolling
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  // ═══════════════════════════════════════════════════════════════════════════
  // 📝 EDITOR
  // ═══════════════════════════════════════════════════════════════════════════
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.inlineSuggest.enabled": true,
  // ═══════════════════════════════════════════════════════════════════════════
  // 🔍 FILES & SEARCH
  // ═══════════════════════════════════════════════════════════════════════════
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.git": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.venv": true
  },
  // ═══════════════════════════════════════════════════════════════════════════
  // 🖥️ TERMINAL
  // ═══════════════════════════════════════════════════════════════════════════
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.defaultProfile.osx": "zsh",
  // ═══════════════════════════════════════════════════════════════════════════
  // 🐍 PYTHON (Astral stack)
  // ═══════════════════════════════════════════════════════════════════════════
  // Using Ty instead of Pylance for type checking
  "python.languageServer": "None",
  // Ruff for linting AND formatting
  "ruff.enable": true,
  "ruff.lint.enable": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.rulers": [
      88
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  // Jupyter
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.fixAll": "explicit",
    "notebook.source.organizeImports": "explicit"
  },
  // ═══════════════════════════════════════════════════════════════════════════
  // 📄 OTHER LANGUAGES
  // ═══════════════════════════════════════════════════════════════════════════
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.tabSize": 2
  },
  // ═══════════════════════════════════════════════════════════════════════════
  // 🔌 EXTENSIONS
  // ═══════════════════════════════════════════════════════════════════════════
  // Error Lens
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning"
  ],
  // GitLens (less intrusive)
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": true,
  // TODO Tree
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "BUG",
    "HACK",
    "NOTE"
  ],
  // ═══════════════════════════════════════════════════════════════════════════
  // 🔒 GIT
  // ═══════════════════════════════════════════════════════════════════════════
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  // ═══════════════════════════════════════════════════════════════════════════
  // 🔇 TELEMETRY
  // ═══════════════════════════════════════════════════════════════════════════
  "telemetry.telemetryLevel": "off"
  // ═══════════════════════════════════════════════════════════════════════════
  // OPTIONAL: Uncomment if using these tools
  // ═══════════════════════════════════════════════════════════════════════════
  // ─── Web Development (Prettier) ────────────────────────────────────────────
  // "[javascript]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  // "[typescript]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  // "[html]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  // "[css]": {
  //   "editor.defaultFormatter": "esbenp.prettier-vscode"
  // },
  // "prettier.singleQuote": true,
  // "prettier.trailingComma": "es5",
  // ─── Tailwind CSS ──────────────────────────────────────────────────────────
  // "tailwindCSS.emmetCompletions": true,
  // ─── Docker Compose ────────────────────────────────────────────────────────
  // "[dockercompose]": {
  //   "editor.defaultFormatter": "redhat.vscode-yaml"
  // },
}
